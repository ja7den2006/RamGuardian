<Window x:Class="RamGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="RamGuardian"
        Width="290"
        Height="220"
        MinWidth="290"
        MinHeight="220"
        MaxWidth="290"
        MaxHeight="220"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        Closing="OnWindowClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="24"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Border Margin="6"
                Padding="7"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="0"
                                  Color="#A1000000"
                                  Opacity="0.30" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="4"
                        Margin="1"
                        BorderBrush="{StaticResource InnerEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Opacity="0.9"
                        IsHitTestVisible="False" />

                <Grid Grid.Row="0"
                      Margin="0,0,0,4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Bahnschrift"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="RamGuardian" />

                    <Button x:Name="HideToTrayButton"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="OnHideToTrayClicked"
                            ToolTip="Hide to tray"
                            Content="×" />
                </Grid>

                <Border Grid.Row="1"
                        Margin="3,0,3,5"
                        Padding="6"
                        Background="{StaticResource CardInsetBrush}"
                        BorderBrush="{StaticResource CardSoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock x:Name="UsageTextBlock"
                                       Margin="0,0,0,3"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Current ram usage"
                                       TextOptions.TextFormattingMode="Display" />

                            <TextBlock x:Name="UsageValueTextBlock"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="-- / --" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                MinWidth="34"
                                Height="18"
                                Margin="6,0,0,0"
                                Padding="5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource UsageBadgeBrush}"
                                BorderBrush="{StaticResource UsageBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <TextBlock x:Name="UsagePercentTextBlock"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="--%" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="2,0,2,5"
                        Height="1"
                        Background="#231015" />

                <StackPanel Grid.Row="3">
                    <Button x:Name="CleanRamButton"
                            Margin="0,0,0,4"
                            Style="{StaticResource StateButtonStyle}"
                            Click="OnCleanRamClicked"
                            Content="Clean Ram" />

                    <Button x:Name="AutoCleanButton"
                            Margin="0,0,0,4"
                            Style="{StaticResource StateButtonStyle}"
                            Click="OnAutoCleanClicked"
                            Content="Auto-Clean Off" />

                    <Button x:Name="ExitButton"
                            Background="{StaticResource ButtonExitBrush}"
                            BorderBrush="#36404F"
                            Margin="0,0,0,0"
                            Style="{StaticResource StateButtonStyle}"
                            Click="OnExitClicked"
                            Content="Stop and exit program" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
